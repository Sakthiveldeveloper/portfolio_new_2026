# Get your free access key at https://web3forms.com (use sakthivel24498@gmail.com)
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Netlify setup:
# 1. Site settings → Environment variables → Add a variable
# 2. Key: VITE_WEB3FORMS_ACCESS_KEY
# 3. Value: paste your Web3Forms access key (same as above)
# 4. Check "Same value for all deploy contexts"
# 5. Deploys → Trigger deploy → Deploy site (required — Vite bakes env vars at build time)
https://app.web3forms.com/dashboard